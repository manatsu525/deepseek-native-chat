HOST=0.0.0.0
PORT=8000
DATA_DIR=/opt/deepseek-native-chat/data
SESSION_DAYS=60
REQUEST_TIMEOUT=1200
TLS_CERT_FILE=/opt/deepseek-native-chat/data/tls/server.crt
TLS_KEY_FILE=/opt/deepseek-native-chat/data/tls/server.key
# Emergency kill switch for the optional OpenCode DeepSeek DSML parser.
OPENCODE_DSML_FALLBACK=1
